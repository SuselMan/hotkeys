{
  "expo": {
    "name": "kekkeys",
    "slug": "kekkeys",
    "scheme": "kekkeys",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "android": {
      "package": "online.kekkeys.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "com.android.vending.BILLING"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "online.kekkeys.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "kekkeys uses your camera to scan the pairing QR shown by the desktop app.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "react-native-iap"
    ],
    "extra": {
      "eas": {
        "projectId": "d5282942-b0ba-46ab-9f01-fbc72a7a4bf1"
      }
    },
    "owner": "suselman",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d5282942-b0ba-46ab-9f01-fbc72a7a4bf1"
    }
  }
}
