{
  "name": "@kekkeys/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "node ./scripts/copy-renderer.mjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "dev": "npm run build && electron .",
    "start": "electron ."
  },
  "dependencies": {
    "@kekkeys/protocol": "*",
    "bonjour-service": "^1.3.0",
    "koffi": "^2.16.1",
    "qrcode": "^1.5.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "electron": "^33.0.0",
    "typescript": "^5.6.0"
  }
}
